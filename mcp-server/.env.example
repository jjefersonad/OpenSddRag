# OpenSddRag server — copy to mcp-server/.env for a local Python run.
# Docker Compose also reads these names from the repo root / this file's values.

# --- Database ---
POSTGRES_USER=opensddrag
POSTGRES_PASSWORD=opensddrag
POSTGRES_DB=opensddrag
DB_PORT=54326

# Host-side URL when the server runs on the host and Postgres is in Compose:
# DATABASE_URL=postgresql://opensddrag:opensddrag@localhost:54326/opensddrag
# In-compose URL (service name `db`):
DATABASE_URL=postgresql://opensddrag:opensddrag@db:5432/opensddrag

# --- MCP server ---
MCP_PORT=8000
EMBEDDING_MODEL=all-MiniLM-L6-v2
OPENSDDRAG_PROJECT=default
AUTH_ENABLED=true

# Dashboard + management REST API (/api/v1). Not the MCP API key.
MANAGEMENT_API_TOKEN=123456
WEB_ORIGIN=http://localhost:3001
SERVE_WEB_UI=false

# Web image build arg (dashboard talking to the management API)
# VITE_API_URL=http://localhost:8000/api/v1
# WEB_PORT=3001
